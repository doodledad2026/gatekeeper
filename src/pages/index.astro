---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout title="Expert Edge — Verify Experts Instantly" description="Cross-check expert witnesses and consultants against 8 public registries. Get defensible risk scores in seconds.">
  <SiteHeader />

  <main>
    <!-- Hero Section with Professional Logo -->
    <section class="hero">
      <div class="hero-background">
        <div class="gradient-orb orb-1"></div>
        <div class="gradient-orb orb-2"></div>
        <div class="grid-pattern"></div>
      </div>
      
      <div class="container hero-content">
        <div class="logo-showcase">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="hero-logo">
            <defs>
              <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#001F5B;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#003A8A;stop-opacity:1" />
              </linearGradient>
              <filter id="shadow">
                <feDropShadow dx="0" dy="4" stdDeviation="6" flood-opacity="0.2"/>
              </filter>
            </defs>
            <path d="M100 15 C100 15 60 35 60 85 C60 135 100 165 100 165 C100 165 140 135 140 85 C140 35 100 15 100 15 Z" fill="url(#shieldGrad)" filter="url(#shadow)"/>
            <path d="M100 20 C100 20 65 38 65 85 C65 130 100 158 100 158 C100 158 135 130 135 85 C135 38 100 20 100 20 Z" fill="none" stroke="#C4A77D" stroke-width="2" opacity="0.6"/>
            <path d="M80 95 Q85 110 92 118" stroke="#C4A77D" stroke-width="5" stroke-linecap="round" fill="none"/>
            <path d="M92 118 Q110 90 125 65" stroke="#C4A77D" stroke-width="5" stroke-linecap="round" fill="none"/>
            <line x1="100" y1="15" x2="100" y2="165" stroke="#C4A77D" stroke-width="1" opacity="0.3"/>
          </svg>
        </div>

        <h1 class="hero-title">Verify Experts Instantly</h1>
        <p class="hero-subtitle">
          Cross-check expert witnesses and consultants against 8 authoritative public registries. 
          Get defensible risk scores in seconds, not days.
        </p>

        <div class="hero-ctas">
          <a href="/directory" class="btn btn-primary btn-lg">
            <span>Search Experts</span>
            <span class="arrow">→</span>
          </a>
          <a href="/about" class="btn btn-secondary btn-lg">
            <span>Learn More</span>
          </a>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <div class="stat-number">35</div>
            <div class="stat-label">Experts Verified</div>
          </div>
          <div class="stat">
            <div class="stat-number">8</div>
            <div class="stat-label">Data Sources</div>
          </div>
          <div class="stat">
            <div class="stat-number">&lt;2s</div>
            <div class="stat-label">Verification Time</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Value Section -->
    <section class="value-section">
      <div class="container">
        <div class="section-header">
          <h2>Why Expert Verification Matters</h2>
          <p>In litigation, expert credibility is everything. One discovery surprise can derail your case.</p>
        </div>

        <div class="value-grid">
          <div class="value-card">
            <div class="value-icon">⚠️</div>
            <h3>Hidden Red Flags</h3>
            <p>Retracted publications, funding conflicts, and disciplinary records often go unnoticed until deposition.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">🎯</div>
            <h3>Faster Vetting</h3>
            <p>Manual research takes hours. Expert Edge delivers comprehensive verification in seconds.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">📋</div>
            <h3>Defensible Documentation</h3>
            <p>Every finding is sourced and cited. Your risk assessment stands up to scrutiny.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">🔒</div>
            <h3>Confidence in Decisions</h3>
            <p>Make informed expert selection with complete, verified background information.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works">
      <div class="container">
        <div class="section-header">
          <h2>Three Steps to Expert Verification</h2>
        </div>

        <div class="steps-container">
          <div class="step-card">
            <div class="step-number">01</div>
            <h3>Search</h3>
            <p>Enter an expert's name. Our system instantly queries 8 major public registries simultaneously.</p>
          </div>

          <div class="step-card">
            <div class="step-number">02</div>
            <h3>Analyze</h3>
            <p>View complete dossier with publications, funding, licenses, patents, and disciplinary records.</p>
          </div>

          <div class="step-card">
            <div class="step-number">03</div>
            <h3>Decide</h3>
            <p>Review risk score and source documentation. Make confident, informed decisions.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="cta-background">
        <div class="gradient-orb orb-3"></div>
      </div>
      
      <div class="container cta-content">
        <h2>Start Verifying Experts Today</h2>
        <p>Get instant access to comprehensive expert verification. Free for your first search.</p>
        <a href="/directory" class="btn btn-primary btn-lg">
          <span>Search Now</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h4>Expert Edge</h4>
          <p>Professional expert verification platform for legal professionals.</p>
        </div>
        <div>
          <h4>Platform</h4>
          <ul>
            <li><a href="/directory">Expert Directory</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/pricing">Pricing</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="#privacy">Privacy</a></li>
            <li><a href="#terms">Terms</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2024 Expert Edge. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    main {
      position: relative;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Hero Section */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 4rem 0;
    }

    .hero-background {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .grid-pattern {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(196, 167, 125, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(196, 167, 125, 0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      animation: drift 20s linear infinite;
    }

    .gradient-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.1;
    }

    .orb-1 {
      width: 500px;
      height: 500px;
      background: #C4A77D;
      top: -200px;
      right: -200px;
      animation: float 8s ease-in-out infinite;
    }

    .orb-2 {
      width: 400px;
      height: 400px;
      background: #001F5B;
      bottom: -150px;
      left: -150px;
      animation: float 10s ease-in-out infinite 1s;
    }

    .orb-3 {
      width: 600px;
      height: 600px;
      background: #C4A77D;
      top: -300px;
      left: -300px;
      animation: float 12s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(30px, -30px); }
    }

    @keyframes drift {
      0% { transform: translate(0, 0); }
      100% { transform: translate(50px, 50px); }
    }

    .hero-content {
      position: relative;
      z-index: 1;
      text-align: center;
      animation: fadeInUp 0.8s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo-showcase {
      margin-bottom: 2rem;
      display: flex;
      justify-content: center;
    }

    .hero-logo {
      width: 140px;
      height: 140px;
      animation: scaleIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1), bobbing 3s ease-in-out infinite 0.8s;
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.8) rotateZ(-10deg);
      }
      to {
        opacity: 1;
        transform: scale(1) rotateZ(0);
      }
    }

    @keyframes bobbing {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    .hero-title {
      font-size: clamp(2.5rem, 8vw, 4.5rem);
      line-height: 1.1;
      margin-bottom: 1.5rem;
      font-family: var(--font-display);
      font-weight: 700;
      color: #001F5B;
    }

    .hero-subtitle {
      font-size: 1.2rem;
      color: #606060;
      max-width: 650px;
      margin: 0 auto 2.5rem;
      line-height: 1.7;
    }

    .hero-ctas {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 4rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 2rem;
      border-radius: 8px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      text-decoration: none;
      font-family: var(--font-body);
    }

    .btn-primary {
      background: linear-gradient(135deg, #C4A77D, #b39568);
      color: white;
      box-shadow: 0 10px 30px rgba(196, 167, 125, 0.2);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 40px rgba(196, 167, 125, 0.3);
    }

    .btn-secondary {
      background: transparent;
      color: #001F5B;
      border: 2px solid #001F5B;
    }

    .btn-secondary:hover {
      background: #001F5B;
      color: white;
      transform: translateY(-2px);
    }

    .btn-lg {
      padding: 1.25rem 2.5rem;
      font-size: 1.05rem;
    }

    .arrow {
      transition: transform 0.3s ease;
      display: inline-block;
    }

    .btn:hover .arrow {
      transform: translateX(4px);
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
      padding-top: 2rem;
      border-top: 1px solid rgba(196, 167, 125, 0.2);
    }

    .stat {
      text-align: center;
      animation: fadeInUp 0.8s ease-out 0.2s backwards;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #C4A77D;
      line-height: 1;
    }

    .stat-label {
      color: #606060;
      font-size: 0.9rem;
      margin-top: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Sections */
    .section-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .section-header h2 {
      font-size: clamp(2rem, 5vw, 3rem);
      color: #001F5B;
      margin-bottom: 1rem;
    }

    .section-header p {
      font-size: 1.1rem;
      color: #606060;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Value Section */
    .value-section {
      padding: 6rem 0;
      background: linear-gradient(180deg, #F5F5F5, white);
    }

    .value-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }

    .value-card {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid rgba(196, 167, 125, 0.1);
      transition: all 0.3s ease;
      animation: slideInUp 0.6s ease-out backwards;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .value-card:hover {
      border-color: #C4A77D;
      box-shadow: 0 20px 40px rgba(196, 167, 125, 0.1);
      transform: translateY(-5px);
    }

    .value-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .value-card h3 {
      color: #001F5B;
      margin-bottom: 0.75rem;
    }

    /* How It Works */
    .how-it-works {
      padding: 6rem 0;
      background: white;
    }

    .steps-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }

    .step-card {
      padding: 2.5rem;
      background: linear-gradient(135deg, #F5F5F5, white);
      border-radius: 12px;
      border: 1px solid rgba(196, 167, 125, 0.1);
      animation: slideInUp 0.6s ease-out backwards;
    }

    .step-card:hover {
      border-color: #C4A77D;
      box-shadow: 0 15px 30px rgba(196, 167, 125, 0.1);
    }

    .step-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #C4A77D;
      margin-bottom: 1rem;
    }

    .step-card h3 {
      color: #001F5B;
      margin-bottom: 0.75rem;
    }

    /* CTA Section */
    .cta-section {
      position: relative;
      padding: 6rem 0;
      color: white;
      overflow: hidden;
    }

    .cta-background {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #001F5B 0%, #003A8A 100%);
      z-index: 0;
    }

    .cta-content {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .cta-section h2 {
      font-size: clamp(2rem, 5vw, 3rem);
      color: white;
      margin-bottom: 1rem;
    }

    .cta-section p {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 2rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Footer */
    .footer {
      background: #001F5B;
      color: white;
      padding: 3rem 0 1.5rem;
      border-top: 3px solid #C4A77D;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer-grid h4 {
      color: #C4A77D;
      margin-bottom: 1rem;
    }

    .footer-grid p {
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.6;
    }

    .footer-grid ul {
      list-style: none;
    }

    .footer-grid li {
      margin-bottom: 0.75rem;
    }

    .footer-grid a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: color 0.3s;
    }

    .footer-grid a:hover {
      color: #C4A77D;
    }

    .footer-bottom {
      text-align: center;
      color: rgba(255, 255, 255, 0.5);
    }

    @media (max-width: 768px) {
      .hero-ctas {
        flex-direction: column;
      }

      .hero-stats {
        gap: 2rem;
      }
    }
  </style>
</BaseLayout>
