---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout title="Expert Edge — Expert Verification System" description="Verify expert witnesses and consultants against public records.">
  <SiteHeader />

  <!-- Hero Section -->
  <section style="padding: 5rem 0; background: white;">
    <div class="container-sm text-center">
      <h1 style="margin-bottom: 1rem; font-size: 2.75rem;">
        Stop Vetting Experts Manually
      </h1>
      <p style="font-size: 1.25rem; color: #999; margin-bottom: 2rem;">
        Expert Edge verifies expert witnesses and consultants against 8 public registries in seconds. Get defensible risk scores for every expert.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="#get-started" class="btn btn-primary" style="font-size: 1.1rem; padding: 1rem 2rem;">
          Get Free Instant Access
        </a>
        <a href="#learn-more" class="btn btn-outline" style="font-size: 1.1rem; padding: 1rem 2rem;">
          Learn More
        </a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" style="padding: 5rem 0; background: #F5F5F5;">
    <div class="container">
      <h2 style="text-align: center; margin-bottom: 3rem;">Key Features</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        
        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #C4A77D;">
          <h3 style="color: #001F5B; margin-bottom: 1rem;">Instant Verification</h3>
          <p>Search any expert by name and get results in seconds. Cross-referenced against 8 major public registries.</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #C4A77D;">
          <h3 style="color: #001F5B; margin-bottom: 1rem;">Risk Scoring</h3>
          <p>Automated risk assessment based on publications, retractions, funding, licenses, and disciplinary records.</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #C4A77D;">
          <h3 style="color: #001F5B; margin-bottom: 1rem;">Source Verification</h3>
          <p>See exactly which registries confirmed each credential. Fully documented and defensible.</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #C4A77D;">
          <h3 style="color: #001F5B; margin-bottom: 1rem;">Easy Export</h3>
          <p>Download comprehensive reports with all findings, citations, and source documentation.</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #C4A77D;">
          <h3 style="color: #001F5B; margin-bottom: 1rem;">Always Current</h3>
          <p>Data updates daily from live sources. Your reports are always based on the latest information.</p>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 8px; border-left: 4px solid #C4A77D;">
          <h3 style="color: #001F5B; margin-bottom: 1rem;">Confidential</h3>
          <p>Enterprise-grade security. Your searches and reports are private and encrypted.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" style="padding: 5rem 0; background: white;">
    <div class="container-sm">
      <h2 style="text-align: center; margin-bottom: 3rem;">How It Works</h2>
      
      <div style="display: flex; gap: 2rem; margin-bottom: 2rem; align-items: flex-start;">
        <div style="flex-shrink: 0;">
          <div style="width: 50px; height: 50px; background: #C4A77D; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700;">1</div>
        </div>
        <div>
          <h3 style="color: #001F5B; margin-bottom: 0.5rem;">Search</h3>
          <p>Enter the expert's name or credentials. Our system searches across all registries simultaneously.</p>
        </div>
      </div>

      <div style="display: flex; gap: 2rem; margin-bottom: 2rem; align-items: flex-start;">
        <div style="flex-shrink: 0;">
          <div style="width: 50px; height: 50px; background: #C4A77D; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700;">2</div>
        </div>
        <div>
          <h3 style="color: #001F5B; margin-bottom: 0.5rem;">Verify</h3>
          <p>Cross-reference results against publications, retractions, funding, patents, bar status, and more.</p>
        </div>
      </div>

      <div style="display: flex; gap: 2rem; align-items: flex-start;">
        <div style="flex-shrink: 0;">
          <div style="width: 50px; height: 50px; background: #C4A77D; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700;">3</div>
        </div>
        <div>
          <h3 style="color: #001F5B; margin-bottom: 0.5rem;">Decide</h3>
          <p>Get a defensible risk score and full documentation. Make informed decisions backed by data.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Sources -->
  <section style="padding: 5rem 0; background: #F5F5F5;">
    <div class="container">
      <h2 style="text-align: center; margin-bottom: 3rem;">We Check 8 Major Public Registries</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">📰</div>
          <h4 style="color: #001F5B;">PubMed</h4>
          <p style="font-size: 0.9rem;">Medical publications &amp; indexed research</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">✓</div>
          <h4 style="color: #001F5B;">ORCID</h4>
          <p style="font-size: 0.9rem;">Researcher identity &amp; publication history</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">💰</div>
          <h4 style="color: #001F5B;">NIH Reporter</h4>
          <p style="font-size: 0.9rem;">Federal research funding records</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">🔗</div>
          <h4 style="color: #001F5B;">CrossRef</h4>
          <p style="font-size: 0.9rem;">Publication metadata &amp; citations</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">⚠️</div>
          <h4 style="color: #001F5B;">RetractionWatch</h4>
          <p style="font-size: 0.9rem;">Retracted &amp; flagged publications</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">📜</div>
          <h4 style="color: #001F5B;">Patents</h4>
          <p style="font-size: 0.9rem;">USPTO patent filings &amp; citations</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">⚖️</div>
          <h4 style="color: #001F5B;">State Bar</h4>
          <p style="font-size: 0.9rem;">Attorney licenses &amp; disciplinary records</p>
        </div>
        <div style="text-align: center;">
          <div style="color: #C4A77D; font-size: 2rem; margin-bottom: 0.5rem;">🔬</div>
          <h4 style="color: #001F5B;">arXiv</h4>
          <p style="font-size: 0.9rem;">Preprints &amp; academic research</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="get-started" style="padding: 5rem 0; background: #001F5B; color: white; text-align: center;">
    <div class="container-sm">
      <h2 style="color: white; margin-bottom: 1rem;">Start Vetting Experts Today</h2>
      <p style="color: rgba(255,255,255,0.9); font-size: 1.1rem; margin-bottom: 2rem;">
        Get instant access to verified expert records. Free for your first 5 searches.
      </p>
      <a href="mailto:hello@expertedge.com" class="btn btn-primary" style="font-size: 1.1rem; padding: 1rem 2rem;">
        Get Free Access →
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer style="background: #001F5B; color: white; padding: 3rem 0; border-top: 3px solid #C4A77D;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
        <div>
          <h4 style="color: #C4A77D; margin-bottom: 1rem;">Expert Edge</h4>
          <p style="color: rgba(255,255,255,0.7);">Professional expert verification for legal professionals.</p>
        </div>
        <div>
          <h4 style="color: #C4A77D; margin-bottom: 1rem;">Product</h4>
          <ul style="list-style: none;">
            <li><a href="#features" style="color: rgba(255,255,255,0.7); text-decoration: none;">Features</a></li>
            <li><a href="#pricing" style="color: rgba(255,255,255,0.7); text-decoration: none;">Pricing</a></li>
            <li><a href="#" style="color: rgba(255,255,255,0.7); text-decoration: none;">Documentation</a></li>
          </ul>
        </div>
        <div>
          <h4 style="color: #C4A77D; margin-bottom: 1rem;">Company</h4>
          <ul style="list-style: none;">
            <li><a href="#about" style="color: rgba(255,255,255,0.7); text-decoration: none;">About Us</a></li>
            <li><a href="#contact" style="color: rgba(255,255,255,0.7); text-decoration: none;">Contact</a></li>
            <li><a href="#privacy" style="color: rgba(255,255,255,0.7); text-decoration: none;">Privacy</a></li>
          </ul>
        </div>
      </div>
      <div style="border-top: 1px solid rgba(255,255,255,0.2); padding-top: 2rem; text-align: center; color: rgba(255,255,255,0.6);">
        <p>&copy; 2024 Expert Edge. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }
  </style>
</BaseLayout>
