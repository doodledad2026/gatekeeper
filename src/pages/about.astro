---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About Expert Edge" description="Learn about Expert Edge's mission to transform expert verification for legal professionals.">
  <main>
    <!-- Navigation -->
    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">EXPERT EDGE</a>
        <div class="nav-menu">
          <a href="/#product" class="nav-link">Product</a>
          <a href="/#solutions" class="nav-link">Solutions</a>
          <a href="/#security" class="nav-link">Security</a>
          <a href="/#customers" class="nav-link">Customers</a>
          <a href="/#company" class="nav-link">Company</a>
        </div>
        <div class="nav-right">
          <a href="#" class="login-link">Log in</a>
          <a href="#" class="book-demo-btn">
            <span>Book a demo</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Home</a> / <span>About</span>
        </div>
        <h1>Our Mission</h1>
        <p>Transforming expert verification for the legal profession</p>
      </div>
    </section>

    <!-- Story Section -->
    <section class="section">
      <div class="container">
        <div class="story-grid">
          <div class="story-text">
            <h2>The Problem We're Solving</h2>
            <p>In litigation, expert credibility is everything. A single discovery surprise—a retracted publication, an undisclosed conflict, a disciplinary record—can derail your case and damage your reputation.</p>
            <p>Yet expert verification remains a manual, time-consuming process. Lawyers must search multiple databases independently, cross-reference information, and hope they haven't missed something critical.</p>
            <p>Expert Edge eliminates that risk. We aggregate data from 8 authoritative public registries and deliver comprehensive, defensible expert assessments in seconds.</p>
          </div>
          <div class="story-stats">
            <div class="story-stat">
              <div class="stat-number">2-4 hours</div>
              <div class="stat-label">Time for manual research</div>
            </div>
            <div class="story-stat">
              <div class="stat-number">&lt;2 seconds</div>
              <div class="stat-label">Expert Edge verification</div>
            </div>
            <div class="story-stat">
              <div class="stat-number">35+</div>
              <div class="stat-label">Pre-verified experts</div>
            </div>
            <div class="story-stat">
              <div class="stat-number">100%</div>
              <div class="stat-label">Sourced & cited</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="section dark-section">
      <div class="container">
        <h2 class="section-title">Our Values</h2>
        <div class="values-grid">
          <div class="value-card">
            <div class="value-icon">⚡</div>
            <h3>Speed</h3>
            <p>Expert verification should take seconds, not hours. We obsess over milliseconds because your time matters.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">✓</div>
            <h3>Trust</h3>
            <p>Every finding is sourced and cited. No hidden algorithms, no black boxes—complete transparency in our data.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">🔒</div>
            <h3>Security</h3>
            <p>Your searches and findings stay confidential. Enterprise-grade encryption, SOC 2 Type II certified, HIPAA compliant.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">📊</div>
            <h3>Accuracy</h3>
            <p>We aggregate data from authoritative sources and apply rigorous verification. Garbage in, garbage out isn't acceptable.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">🤝</div>
            <h3>Simplicity</h3>
            <p>Complex tools fail. We design for how lawyers actually work—search a name, get a dossier, make a decision.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">🎯</div>
            <h3>Impact</h3>
            <p>We help you avoid credibility disasters. That's not just better—it's essential for legal practice.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Our Journey</h2>
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-date">2023</div>
            <h3>Founded</h3>
            <p>Expert Edge launches with a single mission: eliminate expert credibility failures in litigation.</p>
          </div>

          <div class="timeline-item">
            <div class="timeline-date">2023</div>
            <h3>Public Records Integration</h3>
            <p>Successfully integrated 8 authoritative data sources into seamless verification engine.</p>
          </div>

          <div class="timeline-item">
            <div class="timeline-date">2024</div>
            <h3>Beta Launch</h3>
            <p>Early access users from 20+ law firms report 80% time savings on expert vetting.</p>
          </div>

          <div class="timeline-item">
            <div class="timeline-date">2024</div>
            <h3>General Availability</h3>
            <p>Expert Edge opens to all legal professionals. 35 pre-verified experts available immediately.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="section dark-section">
      <div class="container">
        <h2 class="section-title">Why Choose Expert Edge?</h2>

        <div class="comparison">
          <div class="comparison-col">
            <h3>Expert Edge</h3>
            <ul class="feature-list">
              <li>✓ Results in &lt;2 seconds</li>
              <li>✓ 8 data sources automated</li>
              <li>✓ AI risk scoring</li>
              <li>✓ Defensible documentation</li>
              <li>✓ Batch verification</li>
              <li>✓ Enterprise API</li>
              <li>✓ SOC 2 Type II certified</li>
            </ul>
          </div>

          <div class="comparison-col">
            <h3>Manual Research</h3>
            <ul class="feature-list">
              <li>✗ 2-4 hours per expert</li>
              <li>✗ Manual database searches</li>
              <li>✗ Subjective assessment</li>
              <li>✗ Documentation gaps</li>
              <li>✗ Manual repetition</li>
              <li>✗ Not scalable</li>
              <li>✗ Human error risk</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Built by Legal Tech Veterans</h2>
        <p class="section-subtitle">Our team brings decades of experience in legal software, data verification, and expert witness consulting.</p>

        <div class="team-note">
          <p>We're a small, focused team dedicated to solving one problem exceptionally well: expert verification that actually works.</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-final">
      <div class="cta-content">
        <h2>Ready to Verify Experts?</h2>
        <p>Start with 2 free searches. No credit card required.</p>
        <a href="#" class="demo-button large">
          Book a demo
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M8 15L14 10L8 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <h4>EXPERT EDGE</h4>
            <p>Expert verification for legal professionals</p>
          </div>
          <div class="footer-col">
            <h4>Product</h4>
            <ul>
              <li><a href="/directory">Expert Directory</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="#">API Docs</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Company</h4>
            <ul>
              <li><a href="/about">About</a></li>
              <li><a href="#">Blog</a></li>
              <li><a href="#">Contact</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Legal</h4>
            <ul>
              <li><a href="#">Privacy</a></li>
              <li><a href="#">Terms</a></li>
              <li><a href="#">Security</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2024 Expert Edge. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </main>

  <style>
    :root {
      --primary-green: #1A8D5C;
      --dark-bg: #1a1a1a;
      --darker-bg: #121212;
      --text-light: #ffffff;
      --text-gray: #999999;
      --border-color: #333333;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
      background: var(--dark-bg);
      color: var(--text-light);
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Navigation */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(26, 26, 26, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 0;
    }

    .nav-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 2px;
      text-decoration: none;
      color: var(--text-light);
    }

    .nav-menu {
      display: flex;
      gap: 2.5rem;
    }

    .nav-link {
      color: var(--text-light);
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.3s ease;
    }

    .nav-link:hover {
      color: var(--primary-green);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .login-link {
      color: var(--text-light);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .login-link:hover {
      color: var(--primary-green);
    }

    .book-demo-btn {
      background: var(--primary-green);
      color: white;
      padding: 0.7rem 1.5rem;
      border-radius: 50px;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .book-demo-btn:hover {
      background: #158052;
      transform: translateY(-2px);
    }

    /* Hero Section */
    .hero-section {
      padding: 6rem 0;
      background: linear-gradient(135deg, var(--darker-bg), var(--dark-bg));
      border-bottom: 1px solid var(--border-color);
    }

    .breadcrumb {
      color: var(--text-gray);
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .breadcrumb a {
      color: var(--primary-green);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      text-decoration: underline;
    }

    .hero-section h1 {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .hero-section p {
      font-size: 1.2rem;
      color: var(--text-gray);
    }

    /* Sections */
    .section {
      padding: 6rem 0;
      border-bottom: 1px solid var(--border-color);
    }

    .section.dark-section {
      background: var(--darker-bg);
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 1rem;
      text-align: center;
    }

    .section-subtitle {
      text-align: center;
      color: var(--text-gray);
      font-size: 1.1rem;
      margin-bottom: 3rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Story Grid */
    .story-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .story-text h2 {
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
    }

    .story-text p {
      color: var(--text-gray);
      margin-bottom: 1.5rem;
      line-height: 1.8;
    }

    .story-stats {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .story-stat {
      padding: 1.5rem;
      background: rgba(26, 141, 92, 0.1);
      border-left: 3px solid var(--primary-green);
      border-radius: 4px;
    }

    .stat-number {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--primary-green);
      margin-bottom: 0.5rem;
    }

    .stat-label {
      color: var(--text-gray);
      font-size: 0.9rem;
    }

    /* Values Grid */
    .values-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2rem;
    }

    .value-card {
      padding: 2.5rem;
      background: var(--dark-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      transition: all 0.3s ease;
    }

    .value-card:hover {
      border-color: var(--primary-green);
      transform: translateY(-5px);
    }

    .value-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .value-card h3 {
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
    }

    .value-card p {
      color: var(--text-gray);
      line-height: 1.8;
    }

    /* Timeline */
    .timeline {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .timeline-item {
      padding: 2rem;
      background: var(--darker-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
    }

    .timeline-date {
      color: var(--primary-green);
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .timeline-item h3 {
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
    }

    .timeline-item p {
      color: var(--text-gray);
      line-height: 1.8;
    }

    /* Comparison */
    .comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .comparison-col h3 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--primary-green);
    }

    .feature-list {
      list-style: none;
    }

    .feature-list li {
      padding: 0.75rem 0;
      color: var(--text-gray);
      font-size: 0.95rem;
    }

    /* Team Note */
    .team-note {
      max-width: 700px;
      margin: 3rem auto;
      padding: 2rem;
      background: rgba(26, 141, 92, 0.1);
      border-left: 3px solid var(--primary-green);
      border-radius: 4px;
      text-align: center;
    }

    .team-note p {
      color: var(--text-gray);
      line-height: 1.8;
    }

    /* CTA Final */
    .cta-final {
      padding: 6rem 0;
      text-align: center;
      background: linear-gradient(135deg, var(--darker-bg), var(--dark-bg));
      border-top: 1px solid var(--border-color);
    }

    .cta-content h2 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .cta-content p {
      font-size: 1.1rem;
      color: var(--text-gray);
      margin-bottom: 2rem;
    }

    .demo-button {
      background: var(--primary-green);
      color: white;
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1rem;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .demo-button:hover {
      background: #158052;
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(26, 141, 92, 0.3);
    }

    .demo-button.large {
      font-size: 1.05rem;
      padding: 1.2rem 3rem;
    }

    /* Footer */
    .footer {
      background: var(--darker-bg);
      border-top: 1px solid var(--border-color);
      padding: 4rem 0 2rem;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border-color);
    }

    .footer-col h4 {
      margin-bottom: 1rem;
      font-size: 0.95rem;
      font-weight: 600;
    }

    .footer-col p {
      color: var(--text-gray);
      font-size: 0.9rem;
    }

    .footer-col ul {
      list-style: none;
    }

    .footer-col ul li {
      margin-bottom: 0.75rem;
    }

    .footer-col a {
      color: var(--text-gray);
      text-decoration: none;
      transition: color 0.3s ease;
      font-size: 0.9rem;
    }

    .footer-col a:hover {
      color: var(--primary-green);
    }

    .footer-bottom {
      text-align: center;
      color: var(--text-gray);
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      .nav-menu {
        display: none;
      }

      .story-grid {
        grid-template-columns: 1fr;
      }

      .comparison {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
