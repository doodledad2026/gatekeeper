---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout title="About Expert Edge" description="Expert Edge is a professional expert verification platform that helps legal professionals identify risks instantly.">
  <SiteHeader />

  <main>
    <!-- Hero Section -->
    <section class="about-hero">
      <div class="container">
        <div class="section-header">
          <h1>About Expert Edge</h1>
          <p>The fastest, most comprehensive expert verification platform for legal professionals.</p>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="mission-section">
      <div class="container">
        <div class="mission-content">
          <div class="mission-text">
            <h2>Our Mission</h2>
            <p>
              Expert credibility is everything in litigation. A single discovery surprise—a retracted publication,
              an undisclosed conflict of interest, a disciplinary record—can derail your case and damage your reputation.
            </p>
            <p>
              Expert Edge exists to eliminate that risk. We believe legal professionals deserve instant access to
              comprehensive, verified expert backgrounds. No manual searches across multiple databases. No guessing
              whether you've missed something critical.
            </p>
            <p>
              We aggregate data from 8 authoritative public registries and deliver defensible risk assessments in seconds,
              not days.
            </p>
          </div>
          <div class="mission-visual">
            <div class="visual-box">
              <div class="stat-large">
                <div class="stat-number">8</div>
                <div class="stat-label">Public Data Sources</div>
              </div>
              <div class="stat-large">
                <div class="stat-number">&lt;2s</div>
                <div class="stat-label">Verification Time</div>
              </div>
              <div class="stat-large">
                <div class="stat-number">100%</div>
                <div class="stat-label">Sourced & Cited</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Competitive Advantage Section -->
    <section class="competitive-advantage">
      <div class="container">
        <div class="section-header">
          <h2>Why Choose Expert Edge?</h2>
          <p>How we stand apart from manual research and traditional alternatives.</p>
        </div>

        <div class="comparison-grid">
          <!-- Expert Edge -->
          <div class="comparison-col expert-edge">
            <h3>Expert Edge</h3>
            <div class="comparison-list">
              <div class="comparison-item">
                <span class="check">✓</span>
                <div>
                  <strong>Instant Results</strong>
                  <p>&lt;2 seconds per expert across all 8 registries</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="check">✓</span>
                <div>
                  <strong>Complete Coverage</strong>
                  <p>8 authoritative data sources aggregated automatically</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="check">✓</span>
                <div>
                  <strong>Automated Risk Scoring</strong>
                  <p>Algorithm calculates confidence-weighted risk profiles</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="check">✓</span>
                <div>
                  <strong>Defensible Documentation</strong>
                  <p>Every finding is source-cited and court-ready</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="check">✓</span>
                <div>
                  <strong>Batch Verification</strong>
                  <p>Verify multiple experts in a single action</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="check">✓</span>
                <div>
                  <strong>Enterprise Ready</strong>
                  <p>API integration, custom reports, audit trails</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Manual Research -->
          <div class="comparison-col manual">
            <h3>Manual Research</h3>
            <div class="comparison-list">
              <div class="comparison-item">
                <span class="cross">✗</span>
                <div>
                  <strong>Time Consuming</strong>
                  <p>2-4 hours per expert across multiple databases</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="cross">✗</span>
                <div>
                  <strong>Incomplete</strong>
                  <p>Easy to miss registries or recent updates</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="cross">✗</span>
                <div>
                  <strong>Subjective Assessment</strong>
                  <p>Relies on researcher interpretation</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="cross">✗</span>
                <div>
                  <strong>Documentation Gaps</strong>
                  <p>May lack proper sourcing for litigation</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="cross">✗</span>
                <div>
                  <strong>Manual Repetition</strong>
                  <p>No process scaling; same work for each expert</p>
                </div>
              </div>
              <div class="comparison-item">
                <span class="cross">✗</span>
                <div>
                  <strong>Not Scalable</strong>
                  <p>Difficult to manage across teams or cases</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Data Sources Section -->
    <section class="data-sources">
      <div class="container">
        <div class="section-header">
          <h2>Comprehensive Data Coverage</h2>
          <p>We aggregate from the most authoritative public registries. All verifiable. All sourced.</p>
        </div>

        <div class="sources-grid">
          <div class="source-card">
            <h4>PubMed Central</h4>
            <p>Publications, retractions, and citations across biomedical literature</p>
          </div>
          <div class="source-card">
            <h4>State Bar Associations</h4>
            <p>Attorney licensing status, disciplinary records, bar standing</p>
          </div>
          <div class="source-card">
            <h4>Medical Board Registries</h4>
            <p>Physician licensing, sanctions, and disciplinary history</p>
          </div>
          <div class="source-card">
            <h4>USPTO Patents</h4>
            <p>Patent inventorships and technology development history</p>
          </div>
          <div class="source-card">
            <h4>NSF Funding Database</h4>
            <p>Research funding amounts, awarded institutions, and grant history</p>
          </div>
          <div class="source-card">
            <h4>NIH Funding Database</h4>
            <p>Medical research funding, principal investigators, and awards</p>
          </div>
          <div class="source-card">
            <h4>Academic Institutional Data</h4>
            <p>Faculty listings, degrees, certifications, and affiliations</p>
          </div>
          <div class="source-card">
            <h4>Corporate Disclosure Registries</h4>
            <p>Board affiliations, consulting relationships, and financial conflicts</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works">
      <div class="container">
        <div class="section-header">
          <h2>The Expert Edge Process</h2>
        </div>

        <div class="process-timeline">
          <div class="timeline-item">
            <div class="timeline-number">01</div>
            <h3>You Search</h3>
            <p>Enter an expert's name and we instantly query all 8 authoritative registries simultaneously.</p>
          </div>

          <div class="timeline-divider"></div>

          <div class="timeline-item">
            <div class="timeline-number">02</div>
            <h3>We Aggregate</h3>
            <p>All data is collected, deduplicated, and cross-referenced for accuracy and completeness.</p>
          </div>

          <div class="timeline-divider"></div>

          <div class="timeline-item">
            <div class="timeline-number">03</div>
            <h3>We Analyze</h3>
            <p>Our algorithm detects red flags: retractions, conflicts, funding relationships, and disciplinary records.</p>
          </div>

          <div class="timeline-divider"></div>

          <div class="timeline-item">
            <div class="timeline-number">04</div>
            <h3>You Decide</h3>
            <p>You receive a complete dossier with risk score, all findings sourced and cited, ready for litigation.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="cta-background">
        <div class="gradient-orb orb-3"></div>
      </div>

      <div class="container cta-content">
        <h2>See Expert Edge in Action</h2>
        <p>Verify your first expert for free. No credit card required.</p>
        <a href="/directory" class="btn btn-primary btn-lg">
          <span>Search Experts</span>
          <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h4>Expert Edge</h4>
          <p>Professional expert verification platform for legal professionals.</p>
        </div>
        <div>
          <h4>Platform</h4>
          <ul>
            <li><a href="/directory">Expert Directory</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/pricing">Pricing</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="#privacy">Privacy</a></li>
            <li><a href="#terms">Terms</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2024 Expert Edge. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* About Hero */
    .about-hero {
      padding: 6rem 0 4rem;
      background: linear-gradient(180deg, #F5F5F5, white);
    }

    .section-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .section-header h1 {
      font-size: clamp(2.5rem, 8vw, 4rem);
      color: #001F5B;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .section-header h2 {
      font-size: clamp(2rem, 5vw, 3rem);
      color: #001F5B;
      margin-bottom: 1rem;
    }

    .section-header p {
      font-size: 1.1rem;
      color: #606060;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Mission Section */
    .mission-section {
      padding: 6rem 0;
      background: white;
    }

    .mission-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .mission-text p {
      font-size: 1.05rem;
      line-height: 1.8;
      color: #606060;
      margin-bottom: 1.5rem;
    }

    .mission-visual {
      display: flex;
      justify-content: center;
    }

    .visual-box {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem;
      background: linear-gradient(135deg, #F5F5F5, white);
      border-radius: 12px;
      border: 1px solid rgba(196, 167, 125, 0.2);
    }

    .stat-large {
      text-align: center;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #C4A77D;
    }

    .stat-label {
      color: #606060;
      font-size: 0.9rem;
      margin-top: 0.5rem;
    }

    /* Competitive Advantage */
    .competitive-advantage {
      padding: 6rem 0;
      background: linear-gradient(180deg, #F5F5F5, white);
    }

    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-top: 3rem;
    }

    .comparison-col {
      padding: 2.5rem;
      border-radius: 12px;
      border: 2px solid rgba(196, 167, 125, 0.2);
      animation: slideInUp 0.6s ease-out backwards;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .comparison-col h3 {
      color: #001F5B;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .comparison-col.expert-edge {
      background: linear-gradient(135deg, rgba(196, 167, 125, 0.05), rgba(196, 167, 125, 0.02));
      border-color: #C4A77D;
    }

    .comparison-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .comparison-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .check, .cross {
      font-size: 1.25rem;
      font-weight: 700;
      flex-shrink: 0;
      width: 24px;
      text-align: center;
    }

    .check {
      color: #57b487;
    }

    .cross {
      color: #e5677a;
    }

    .comparison-item strong {
      color: #001F5B;
      display: block;
      margin-bottom: 0.25rem;
    }

    .comparison-item p {
      color: #606060;
      font-size: 0.9rem;
      margin: 0;
    }

    /* Data Sources */
    .data-sources {
      padding: 6rem 0;
      background: white;
    }

    .sources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .source-card {
      padding: 2rem;
      background: linear-gradient(135deg, #F5F5F5, white);
      border-radius: 12px;
      border: 1px solid rgba(196, 167, 125, 0.2);
      transition: all 0.3s ease;
      animation: slideInUp 0.6s ease-out backwards;
    }

    .source-card:hover {
      border-color: #C4A77D;
      box-shadow: 0 15px 30px rgba(196, 167, 125, 0.1);
      transform: translateY(-5px);
    }

    .source-card h4 {
      color: #001F5B;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }

    .source-card p {
      color: #606060;
      font-size: 0.9rem;
      margin: 0;
      line-height: 1.6;
    }

    /* How It Works */
    .how-it-works {
      padding: 6rem 0;
      background: linear-gradient(180deg, #F5F5F5, white);
    }

    .process-timeline {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      align-items: center;
      margin-top: 3rem;
    }

    .timeline-item {
      text-align: center;
      padding: 2rem;
      background: white;
      border-radius: 12px;
      border: 1px solid rgba(196, 167, 125, 0.2);
      animation: slideInUp 0.6s ease-out backwards;
    }

    .timeline-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #C4A77D;
      margin-bottom: 1rem;
    }

    .timeline-item h3 {
      color: #001F5B;
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .timeline-item p {
      color: #606060;
      font-size: 0.9rem;
      margin: 0;
      line-height: 1.6;
    }

    .timeline-divider {
      display: none;
    }

    /* CTA Section */
    .cta-section {
      position: relative;
      padding: 6rem 0;
      color: white;
      overflow: hidden;
    }

    .cta-background {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #001F5B 0%, #003A8A 100%);
      z-index: 0;
    }

    .gradient-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.1;
    }

    .orb-3 {
      width: 600px;
      height: 600px;
      background: #C4A77D;
      top: -300px;
      left: -300px;
      animation: float 12s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(30px, -30px); }
    }

    .cta-content {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .cta-section h2 {
      font-size: clamp(2rem, 5vw, 3rem);
      color: white;
      margin-bottom: 1rem;
    }

    .cta-section p {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 2rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 2rem;
      border-radius: 8px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      text-decoration: none;
      font-family: inherit;
    }

    .btn-primary {
      background: linear-gradient(135deg, #C4A77D, #b39568);
      color: white;
      box-shadow: 0 10px 30px rgba(196, 167, 125, 0.2);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 40px rgba(196, 167, 125, 0.3);
    }

    .btn-lg {
      padding: 1.25rem 2.5rem;
      font-size: 1.05rem;
    }

    .arrow {
      transition: transform 0.3s ease;
      display: inline-block;
    }

    .btn:hover .arrow {
      transform: translateX(4px);
    }

    /* Footer */
    .footer {
      background: #001F5B;
      color: white;
      padding: 3rem 0 1.5rem;
      border-top: 3px solid #C4A77D;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer-grid h4 {
      color: #C4A77D;
      margin-bottom: 1rem;
    }

    .footer-grid p {
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.6;
    }

    .footer-grid ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-grid li {
      margin-bottom: 0.75rem;
    }

    .footer-grid a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: color 0.3s;
    }

    .footer-grid a:hover {
      color: #C4A77D;
    }

    .footer-bottom {
      text-align: center;
      color: rgba(255, 255, 255, 0.5);
    }

    @media (max-width: 768px) {
      .mission-content {
        grid-template-columns: 1fr;
      }

      .comparison-grid {
        grid-template-columns: 1fr;
      }

      .process-timeline {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
