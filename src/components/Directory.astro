---
import IconSearch from "./icons/IconSearch.astro";
import IconFilter from "./icons/IconFilter.astro";
---
<section id="directory" class="border-b border-line bg-paper-alt">
  <div class="container-edge py-16 md:py-24">
    <div class="mb-10 max-w-xl">
      <p class="mb-3 font-mono text-xs tracking-widest text-signal uppercase">[ 04 / Directory ]</p>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Search the live record.
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        Loaded at runtime from <code class="font-mono text-xs">expert_data.json</code>,
        refreshed independently of this build.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-3 border border-line bg-paper p-4 sm:grid-cols-12 sm:gap-4 sm:p-5">
      <label class="relative sm:col-span-6">
        <span class="sr-only">Search by name or specialty</span>
        <IconSearch class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-ink-soft" />
        <input
          id="directory-search"
          type="text"
          placeholder="Search name or specialty…"
          class="w-full border border-line bg-paper py-2.5 pr-3 pl-9 text-sm outline-none focus:border-ink"
        />
      </label>

      <label class="sm:col-span-3">
        <span class="sr-only">Filter by industry</span>
        <select
          id="directory-industry"
          class="w-full border border-line bg-paper px-3 py-2.5 text-sm outline-none focus:border-ink"
        >
          <option value="">All industries</option>
          <option value="MDL">MDL / Medical</option>
          <option value="Environmental Law">Environmental Law</option>
          <option value="Financial">Financial</option>
          <option value="Engineering">Engineering</option>
          <option value="Scientific">Scientific</option>
        </select>
      </label>

      <label class="sm:col-span-3">
        <span class="sr-only">Filter by risk level</span>
        <select
          id="directory-risk"
          class="w-full border border-line bg-paper px-3 py-2.5 text-sm outline-none focus:border-ink"
        >
          <option value="">All risk levels</option>
          <option value="LOW">Low</option>
          <option value="MEDIUM">Medium</option>
          <option value="HIGH">High</option>
          <option value="CRITICAL">Critical</option>
        </select>
      </label>
    </div>

    <div class="mt-3 flex items-center gap-2 font-mono text-xs tracking-wide text-ink-soft uppercase">
      <IconFilter class="size-3.5" />
      <span id="directory-count">Loading…</span>
    </div>

    <div id="directory-results" class="mt-6 border-t border-line" aria-live="polite">
      <p class="border-b border-line py-6 text-sm text-ink-soft">Loading records…</p>
    </div>
  </div>
</section>

<script>
  import { initDirectory } from "../scripts/directory";
  initDirectory();
</script>
