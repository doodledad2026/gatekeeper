---
import Logo from "./Logo.astro";

const columns = [
  {
    heading: "Platform",
    links: [
      { label: "Index", href: "/#index" },
      { label: "Coverage", href: "/#coverage" },
      { label: "Sources", href: "/#sources" },
      { label: "Directory", href: "/#directory" },
    ],
  },
  {
    heading: "Guide",
    links: [
      { label: "What is Expert Edge", href: "/guide/what-is-gatekeeper/" },
      { label: "Why use it", href: "/guide/why-use-it/" },
      { label: "How to use", href: "/guide/how-to-use/" },
      { label: "FAQ", href: "/guide/faq/" },
    ],
  },
];
---
<footer class="border-t border-line bg-panel text-ink">
  <div class="container-edge py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <Logo class="size-6 text-signal" />
          <span class="font-display text-sm font-bold tracking-tight uppercase">Expert Edge</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">
          Expert verification across MDL / Medical, Environmental Law, Financial,
          Engineering, and Scientific industries.
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <h4 class="font-mono text-xs tracking-widest text-ink-soft/70 uppercase">{column.heading}</h4>
          <ul class="mt-4 space-y-3">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="inline-flex items-center gap-1.5 text-sm text-ink-soft hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-6 font-mono text-xs text-ink-soft">
      <span>Expert Edge — Trusted Expert Verification</span>
      <span class="max-w-xl">Sources: RetractionWatch · ORCID · NIH Reporter · CrossRef · PubMed · arXiv · USPTO · State Bar</span>
    </div>
  </div>
</footer>
