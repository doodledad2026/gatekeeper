---
import Logo from "./Logo.astro";
import IconArrowUpRight from "./icons/IconArrowUpRight.astro";

const columns = [
  {
    heading: "Platform",
    links: [
      { label: "Index", href: "#index" },
      { label: "Coverage", href: "#coverage" },
      { label: "Sources", href: "#sources" },
      { label: "Directory", href: "#directory" },
    ],
  },
  {
    heading: "Deploy",
    links: [
      { label: "Get started", href: "#deploy" },
      { label: "Quick start guide", href: "/START_HERE.md" },
      { label: "Deployment summary", href: "/DEPLOYMENT_SUMMARY.md" },
    ],
  },
];
---
<footer class="bg-ink text-paper">
  <div class="container-edge py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
      <div>
        <a href="#top" class="flex items-center gap-2.5">
          <Logo class="size-6 text-paper" />
          <span class="font-display text-sm font-bold tracking-tight uppercase">Gatekeeper</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/60">
          Expert verification across MDL / Medical, Environmental Law, Financial,
          Engineering, and Scientific industries.
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <h4 class="font-mono text-xs tracking-widest text-paper/50 uppercase">{column.heading}</h4>
          <ul class="mt-4 space-y-3">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="inline-flex items-center gap-1.5 text-sm text-paper/80 hover:text-paper">
                  {link.label}
                  {link.href.startsWith("/") && <IconArrowUpRight class="size-3.5" />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-paper/15 pt-6 font-mono text-xs text-paper/50">
      <span>Gatekeeper — Trusted Expert Verification</span>
      <span class="max-w-xl">Sources: RetractionWatch · ORCID · NIH Reporter · CrossRef · PubMed · arXiv · USPTO · State Bar</span>
    </div>
  </div>
</footer>
