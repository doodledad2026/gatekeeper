---
// Sharp, flat gate mark — no gradients. A framed checkpoint crossbar
// with a solid seal chip standing in for "verified."
interface Props {
  class?: string;
}
const { class: className = "size-8" } = Astro.props;
---
<svg class={className} viewBox="0 0 48 48" aria-hidden="true">
  <rect x="3" y="3" width="42" height="42" fill="none" stroke="currentColor" stroke-width="3" />
  <line x1="24" y1="3" x2="24" y2="45" stroke="currentColor" stroke-width="3" />
  <line x1="3" y1="24" x2="45" y2="24" stroke="currentColor" stroke-width="3" />
  <rect x="31" y="31" width="14" height="14" class="fill-signal" />
</svg>
