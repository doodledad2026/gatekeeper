---
// Expert Edge logo: shield with checkmark in Legal Navy & Justice Gold
interface Props {
  class?: string;
}
const { class: className = "size-8" } = Astro.props;
---
<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <!-- Shield outline in Legal Navy -->
  <path
    d="M32 8 L48 16 L48 32 C48 44 32 56 32 56 C32 56 16 44 16 32 L16 16 Z"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linejoin="round"
  />

  <!-- Checkmark in Justice Gold -->
  <g class="fill-signal">
    <path
      d="M28 40 L21 33 L24 30 L28 34 L40 18 L43 21 Z"
      fill="currentColor"
    />
  </g>
</svg>
