---
const links = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How It Works" },
  { href: "#get-started", label: "Contact" },
];
---

<header>
  <div class="container">
    <a href="/" class="logo-link">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="header-logo">
        <path d="M100 20 L140 40 L140 90 C140 130 100 160 100 160 C100 160 60 130 60 90 L60 40 Z" fill="none" stroke="white" stroke-width="4" stroke-linejoin="round"/>
        <g>
          <path d="M85 70 L75 95 L85 95 L75 130" stroke="#C4A77D" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M95 95 L110 75 L125 95" stroke="#C4A77D" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </g>
      </svg>
      <span class="logo-text">Expert Edge</span>
    </a>
    
    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a href="#get-started" class="btn btn-header">
      Get Started
    </a>
  </div>
</header>

<style>
  header {
    background: linear-gradient(135deg, #001F5B 0%, #002966 100%);
    padding: 1.25rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0, 31, 91, 0.15);
    border-bottom: 3px solid #C4A77D;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: white;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .logo-link:hover {
    opacity: 0.8;
  }

  .header-logo {
    width: 32px;
    height: 32px;
    filter: drop-shadow(0 4px 10px rgba(196, 167, 125, 0.2));
    transition: transform 0.3s ease;
  }

  .logo-link:hover .header-logo {
    transform: scale(1.1);
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
    height: 2px;
    background: #C4A77D;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .nav-links a:hover {
    color: #C4A77D;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .btn-header {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #C4A77D, #b39568);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
  }

  .btn-header:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(196, 167, 125, 0.3);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .container {
      padding: 0 1rem;
    }

    .logo-text {
      font-size: 1rem;
    }
  }
</style>
