---
const links = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How It Works" },
  { href: "#pricing", label: "Pricing" },
  { href: "#contact", label: "Contact" },
];
---

<header>
  <div class="container flex justify-between items-center">
    <a href="/" class="logo-link">
      <img src="/logo.svg" alt="Expert Edge" class="logo-img" />
      <span class="logo-text">Expert Edge</span>
    </a>
    
    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a href="#get-started" class="btn btn-primary">
      Get Started
    </a>
  </div>
</header>

<style>
  header {
    background: #001F5B;
    color: white;
    padding: 1rem 0;
    border-bottom: 3px solid #C4A77D;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 31, 91, 0.1);
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: white;
    transition: opacity 0.2s;
  }

  .logo-link:hover {
    opacity: 0.8;
  }

  .logo-img {
    width: 40px;
    height: 40px;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #C4A77D;
  }
</style>
