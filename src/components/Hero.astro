---
import { siteStats } from "../data/site";

const readout = [
  { label: "Total experts", value: String(siteStats.totalExperts).padStart(2, "0") },
  { label: "Industries covered", value: String(siteStats.industries).padStart(2, "0") },
  { label: "Data sources", value: String(siteStats.dataSources).padStart(2, "0") },
  { label: "Update cycle", value: "Daily" },
];
---
<section id="top" class="border-b border-line">
  <div class="container-edge grid grid-cols-1 gap-10 py-16 md:grid-cols-12 md:gap-6 md:py-24">
    <div class="md:col-span-7">
      <p class="mb-5 font-mono text-xs tracking-widest text-signal uppercase">
        [ Verification System ]
      </p>
      <h1 class="font-display text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Know exactly who you're putting on the stand.
      </h1>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-ink-soft sm:text-lg">
        Gatekeeper cross-checks expert witnesses and consultants against eight
        public registries — publications, retractions, funding, patents, and
        bar records — and returns a single, defensible risk score.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#directory"
          class="border border-ink bg-ink px-6 py-3 text-center font-mono text-xs tracking-wider text-paper uppercase transition-colors hover:bg-signal hover:border-signal"
        >
          Search the directory
        </a>
        <a
          href="#deploy"
          class="border border-ink px-6 py-3 text-center font-mono text-xs tracking-wider text-ink uppercase transition-colors hover:border-signal hover:text-signal"
        >
          Deploy your own
        </a>
      </div>
    </div>

    <div class="md:col-span-5 md:col-start-8">
      <div class="border border-line">
        <div class="border-b border-line px-5 py-3 font-mono text-[11px] tracking-widest text-ink-soft uppercase">
          System readout
        </div>
        <dl>
          {readout.map((row, i) => (
            <div
              class:list={[
                "flex items-baseline justify-between px-5 py-4",
                i !== readout.length - 1 && "border-b border-line",
              ]}
            >
              <dt class="font-mono text-xs tracking-wide text-ink-soft uppercase">{row.label}</dt>
              <dd class="font-display text-2xl font-bold tabular-nums">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
