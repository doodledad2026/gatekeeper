---
interface Props {
  class?: string;
}
const { class: className = "size-5" } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
  <line x1="5" y1="5" x2="19" y2="19" />
  <line x1="19" y1="5" x2="5" y2="19" />
</svg>
